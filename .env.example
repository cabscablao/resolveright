# =============================================================================
# ResolveRight settings template
# =============================================================================
# HOW TO USE THIS FILE
#   1. Copy it to a new file named ".env" in the same folder:
#        macOS / Linux:      cp .env.example .env
#        Windows PowerShell: Copy-Item .env.example .env
#   2. Open ".env" and replace the placeholder values (the ones that start with "your-").
#   3. NEVER commit ".env", paste it into a chat, or share a screenshot of it. It holds secrets.
#      (".env" is git-ignored on purpose. This template file, ".env.example", holds no secrets.)
#
# GOOD TO KNOW
#   - Only OPENAI_API_KEY is required. Every other line is optional: if you delete it, the
#     app falls back to the default shown here (the defaults live in app/config.py).
#   - On/off settings accept true or false.
#   - Lines starting with "#" are comments and are ignored.
#   - Settings are read once when the app starts. After changing ".env", restart the app.
# =============================================================================


# --- 1. SECRET (required) ----------------------------------------------------
# Your OpenAI API key. The app uses it to call the language model (the "LLM") that understands
# the customer's message and writes the draft reply, and the embedding model that turns policy
# text into searchable numbers.
# Get one at https://platform.openai.com/api-keys (needs an OpenAI account with billing).
# Every call costs a small amount of money, so set a monthly spend limit in the OpenAI dashboard.
# Without a key, the app cannot answer messages (only the offline tests and the
# EMBEDDING_PROVIDER=hash retrieval check below work).
OPENAI_API_KEY=your-openai-key-here


# --- 2. MODELS AND PROMPT WORDING --------------------------------------------
# The chat model that reads the customer's message and drafts the reply.
# Default in code: gpt-4o-mini. The Render deployment (render.yaml) uses gpt-5-nano, which is
# cheaper. Any OpenAI chat model name works. Change this to try another model; no code change needed.
LLM_MODEL=gpt-4o-mini

# How hard "reasoning" models think before answering: minimal, low, medium or high.
# Only used with gpt-5* and o* models (other models ignore it). "minimal" is fastest and cheapest.
LLM_REASONING_EFFORT=minimal

# The embedding model: it turns each piece of policy text, and each question, into a list of
# numbers so the app can find the policy passages closest in meaning to the question.
# It must be the same model for the stored policies and the questions. If you change it, the
# policies are embedded again on the next start (a few cents).
EMBEDDING_MODEL=text-embedding-3-small

# Which wording of the instructions ("prompt") the LLM receives.
#   v1_baseline  : the plain first version
#   v2_grounded  : answers only from retrieved policy text (chosen after comparing v1 to v3)
#   v3_checklist : a step-by-step checklist version
#   v4_approval_aware : v2 reworded for the rule that only escalations wait for a human
#   v5_executing : the agent carries out approved in-policy resolutions itself (D50). Default.
#                  Not compared yet: re-run the evaluations before quoting numbers for it.
# Changing it also starts a fresh set of cached answers (see "Caching" below).
PROMPT_VERSION=v5_executing


# --- 3. FIXED "TODAY" (reproducible results) ---------------------------------
# The date the rules engine treats as today, in YYYY-MM-DD form. Rules such as "30 days to
# return" count days from this date instead of the real calendar.
# Why: the sample orders are built relative to it (for example, one order was delivered 29
# days before it and another 31 days before it). With a fixed date, tests and evaluation
# results are the same on any real day. Leave it as it is unless you regenerate the sample
# data (uv run python -m scripts.generate_data). A real store would use the real date.
AS_OF_DATE=2026-11-02


# --- 4. TRACING WITH LANGFUSE (optional) -------------------------------------
# Langfuse is a web service that records every request step by step (what the LLM was asked,
# which tools ran, how long and how much each took), so you can inspect and debug the agent.
# To use it: create a free project at https://cloud.langfuse.com, copy its two keys here.
# If the keys are missing, tracing is simply skipped and the app works normally.
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
# Must match the region of your Langfuse project: https://cloud.langfuse.com (EU),
# https://us.cloud.langfuse.com (US), https://jp.cloud.langfuse.com (JP).
# A key from one region returns 401 (not authorised) on the others.
LANGFUSE_HOST=https://us.cloud.langfuse.com
# Master switch: set to false to turn tracing off even when the keys are present.
LANGFUSE_ENABLED=true


# --- 5. TESTING ONLY ---------------------------------------------------------
# Deliberately breaks a tool so you can check that the app fails gracefully instead of
# crashing. Format: tool_name:fault, separated by commas. Faults: "timeout" (the tool
# never answers) or "disabled" (the tool is switched off).
# Example: lookup_order:timeout,check_eligibility:disabled
# Keep it EMPTY for normal use.
FAULT_INJECTION=


# --- 6. CACHING (saves money and time) ---------------------------------------
# A cache remembers an earlier answer so the app does not pay for the LLM twice.
#
# Exact cache: reuses the answer only when the very same request (same text, same prompt
# version, same model) comes in again. Stored in a local SQLite file under .cache/.
LLM_CACHE_ENABLED=true
# Semantic cache: also reuses an answer when a new question means almost the same as an old
# one (for example a reworded policy question). Only general policy questions use it; any
# request about a specific order always goes through the full rules check.
SEMANTIC_CACHE_ENABLED=true
# How similar two questions must be to count as the same, from 0 to 1 (1 = identical meaning).
# Higher is stricter: fewer reused answers but fewer wrong ones. 0.92 is a cautious default;
# lower values matched questions that were not really the same.
SEMANTIC_CACHE_THRESHOLD=0.92
# How long a semantic answer may be reused, in seconds. 86400 = 24 hours, so a stale answer
# cannot survive a policy change for longer than a day.
SEMANTIC_CACHE_TTL_SECONDS=86400


# --- 7. ABUSE AND COST PROTECTION --------------------------------------------
# Requests allowed per customer per minute. Extra requests get HTTP 429 ("too many requests")
# with a Retry-After hint.
RATE_LIMIT_PER_MINUTE=10
# Total requests allowed per day across everyone. This caps your OpenAI bill if the public
# URL is flooded. Counts reset when the app restarts.
DAILY_REQUEST_BUDGET=500
# Longest customer message accepted, in characters (1500 is about 250 words). Longer messages
# are refused before any paid call is made.
MAX_MESSAGE_CHARS=1500


# --- 8. POLICY SEARCH ("RAG") ------------------------------------------------
# RAG (retrieval-augmented generation) means: first look up the relevant store policy text,
# then let the LLM answer using only that text. That keeps the answers tied to real policy.
#
# How policy text is turned into numbers: "openai" (real embeddings, needs the key above) or
# "hash" (a simple offline stand-in that needs no key and no internet; lower quality, meant
# for checking that retrieval runs, for example scripts/retrieval_check.py).
EMBEDDING_PROVIDER=openai
# How the policy documents are cut into passages ("chunks") before storing:
#   baseline : fixed-size pieces of about 800 tokens with some overlap (default)
#   section  : one chunk per heading section
CHUNK_STRATEGY=baseline
# How the best passages are found:
#   dense      : by meaning only (default; none of the others scored better on this small corpus)
#   hybrid     : meaning plus keyword match (BM25), merged
#   multiquery : the LLM first rewrites the question several ways
# Details and measured results: docs/evaluation.md.
RETRIEVAL_MODE=dense
# How many policy passages are handed to the LLM per question. 4 gives enough context
# without padding the prompt (more passages = higher cost and more noise).
TOP_K=4
# Read the policy files and store them in the local search index (Qdrant) every time the
# server starts. Needed on a fresh host (Render wipes the disk on each deploy). On your own
# computer it re-embeds only the policy files you changed (a few cents), so an edited policy
# never leaves a stale index. If it fails, the app starts on the existing index and logs it.
# Set false to skip.
INGEST_ON_STARTUP=true
# Delete the case file (logs/cases.json), the order state (logs/order_state.json) and the resolution
# ledger (logs/resolutions.jsonl) every time the server starts, so the Staff Review page never shows
# cases from an earlier session and no refund history carries over (D53, D60). Set false only to keep
# them while debugging.
RESET_CASES_ON_STARTUP=true


# --- 9. CONVERSATION MEMORY --------------------------------------------------
# A conversation (session) forgets its earlier messages after this many seconds of silence.
# 1800 = 30 minutes. Sessions are kept in memory, so a restart also clears them.
SESSION_TTL_SECONDS=1800


# --- 10. GUARDRAILS (safety checks) ------------------------------------------
# Guardrails block unsafe requests (for example "ignore your instructions") and hide
# personal data before it reaches the LLM. The built-in rule checks ALWAYS run; the two
# settings below are optional extras.
#
# OpenAI's moderation check (flags hate, violence, self-harm and similar), applied to the
# drafted reply. If the moderation service cannot be reached, the app carries on and the
# other checks still run. Set false to rely on the built-in rules only.
MODERATION_ENABLED=true
MODERATION_MODEL=omni-moderation-latest
# The Guardrails AI library adds more validators (jailbreak model, profanity, topic) after the
# built-in rules. On by default. It is slower (about 3x per request) and needs model downloads
# and memory, so set false on a small host. It does not switch Langfuse tracing off.
GUARDRAILS_AI_ENABLED=true


# --- 11. EVALUATION AND HELPER SCRIPTS ONLY ----------------------------------
# These are NOT needed to run the app. They are used by the scripts in eval/ and scripts/.
#
# The model that scores draft replies in the "LLM-as-judge" evaluation (make judge).
JUDGE_MODEL=gpt-4o-mini
# The model that writes synthetic test questions (make sdg).
SDG_MODEL=gpt-4o-mini
# Address of the app that scripts/client.py talks to. Use the local address while
# developing, or your public https:// URL after deployment.
RESOLVERIGHT_URL=http://127.0.0.1:8000
